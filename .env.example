GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
UPLOAD_DIRECTORY=./data/uploads
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
# Blank disables the distance cutoff; calibrate against your own questions.
RETRIEVAL_DISTANCE_THRESHOLD=
# Local evidence heuristic; evaluate on labeled questions before changing it.
CHAT_MIN_KEYWORD_COVERAGE=0.5
MAX_UPLOAD_SIZE_MB=20
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
# Explicit opt-in before any retrieved document text is sent to Google.
ALLOW_GEMINI_DOCUMENT_CONTEXT=false
# Separate opt-in for Gemini chat when running the local collection launcher.
LOCAL_ALLOW_GEMINI_DOCUMENT_CONTEXT=false

# Total wall-clock limit per provider operation (includes DNS/proxy setup).
GENERATION_TIMEOUT_SECONDS=100
